load("//tools/bazel:archiva.bzl", "archiva_module")
load("@rules_java//java:defs.bzl", "java_test")

archiva_module(
    name = "archiva-webdav",
    # Tests need the full Spring DI stack including Redback memory impls + JCR;
    # main lib compiles cleanly.
    skip_tests = True,
    deps = [
        "//archiva-modules/archiva-base/archiva-checksum",
        "//archiva-modules/archiva-base/archiva-common",
        "//archiva-modules/archiva-base/archiva-configuration/archiva-configuration-provider",
        "//archiva-modules/archiva-base/archiva-filelock",
        "//archiva-modules/archiva-base/archiva-model",
        "//archiva-modules/archiva-base/archiva-policies",
        "//archiva-modules/archiva-base/archiva-proxy-api",
        "//archiva-modules/archiva-base/archiva-repository-admin/archiva-repository-admin-api",
        "//archiva-modules/archiva-base/archiva-repository-api",
        "//archiva-modules/archiva-base/archiva-security-common",
        "//archiva-modules/archiva-base/archiva-xml-tools",
        "//archiva-modules/archiva-base/archiva-repository-layer",
        "//archiva-modules/archiva-base/archiva-storage-api",
        "//archiva-modules/archiva-base/archiva-storage-fs",
        "//archiva-modules/archiva-scheduler/archiva-scheduler-api",
        "//archiva-modules/archiva-scheduler/archiva-scheduler-repository-api",
        "//archiva-modules/archiva-web/archiva-security",
        "//archiva-modules/metadata/metadata-model",
        "//archiva-modules/metadata/metadata-repository-api",
        "//archiva-modules/plugins/audit",
        "@maven//:commons_io_commons_io",
        "@maven//:jakarta_annotation_jakarta_annotation_api",
        "@maven//:jakarta_servlet_jakarta_servlet_api",
        "@maven//:javax_inject_javax_inject",
        "@maven//:org_apache_archiva_redback_redback_authentication_api",
        "@maven//:org_apache_archiva_redback_redback_authorization_api",
        "@maven//:org_apache_archiva_redback_redback_common_integrations",
        "@maven//:org_apache_archiva_redback_redback_policy",
        "@maven//:org_apache_archiva_redback_redback_system",
        "@maven//:org_apache_archiva_redback_redback_users_api",
        "@maven//:org_apache_commons_commons_collections4",
        "@maven//:org_apache_commons_commons_lang3",
        # for StringEscapeUtils: the listing is HTML built by hand, and every value in it arrives from a request
        # or from a directory a deployer wrote
        "@maven//:org_apache_commons_commons_text",
        "@maven//:org_apache_jackrabbit_jackrabbit_webdav",
        "@maven//:org_apache_jackrabbit_jackrabbit_jcr_commons",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_web",
    ],
)

# The module-wide skip_tests above excludes the tests that need a booted repository and a Spring context. This one
# needs neither: it hands the writer a directory listing and a recording response, which is the only way to see the
# page it produces for whoever browses it.
java_test(
    name = "org.apache.archiva.webdav.util.IndexWriterXssTest",
    size = "small",
    srcs = [
        "src/test/java/org/apache/archiva/webdav/util/IndexWriterXssTest.java",
    ],
    test_class = "org.apache.archiva.webdav.util.IndexWriterXssTest",
    deps = [
        ":archiva-webdav",
        "//archiva-modules/archiva-base/archiva-storage-api",
        "@maven//:javax_jcr_jcr",
        "@maven//:junit_junit",
        "@maven//:org_apache_jackrabbit_jackrabbit_jcr_commons",
        "@maven//:org_apache_jackrabbit_jackrabbit_webdav",
    ],
)

# The module-wide skip_tests above excludes the tests that need the Jackrabbit repository and the Spring DI stack
# behind it. This one needs neither: it asks the session provider when it puts a session on a request, and the
# answer is a call order that only showing up at the gate can show.
java_test(
    name = "org.apache.archiva.webdav.ArchivaDavSessionProviderAttachTest",
    size = "small",
    srcs = [
        "src/test/java/org/apache/archiva/webdav/ArchivaDavSessionProviderAttachTest.java",
    ],
    test_class = "org.apache.archiva.webdav.ArchivaDavSessionProviderAttachTest",
    deps = [
        ":archiva-webdav",
        "//archiva-modules/archiva-web/archiva-security",
        "@maven//:jakarta_servlet_jakarta_servlet_api",
        "@maven//:junit_junit",
        "@maven//:org_apache_archiva_redback_redback_authentication_api",
        "@maven//:org_apache_archiva_redback_redback_common_integrations",
        "@maven//:org_apache_archiva_redback_redback_policy",
        "@maven//:org_apache_archiva_redback_redback_users_api",
        "@maven//:org_apache_jackrabbit_jackrabbit_webdav",
    ],
)
